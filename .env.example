# Kies één van beide:
# Gratis: Google Gemini-sleutel (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Betaald: Anthropic API-sleutel (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optioneel: poort van de lokale server
PORT=3000
# Optioneel: hoe je Jarvis jou moet noemen
JARVIS_USER_NAME=meneer
# Wachtwoord om in te loggen (laat leeg = geen inlogscherm, alleen voor lokaal gebruik!)
JARVIS_PASSWORD=
